<section class="error">
  {{!-- Codigo de estado HTTP en grande (404, 403, 500, ...) --}}
  <p class="error__codigo">{{status}}</p>

  {{!-- Titulo y mensaje calculados en el servidor segun el codigo --}}
  <h1 class="error__titulo">{{titulo}}</h1>
  <p class="error__mensaje">{{mensaje}}</p>

  <a class="error__volver" href="/">Volver al inicio</a>
</section>
